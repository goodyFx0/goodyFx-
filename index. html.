<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GoodyFx AI Gold Signal</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090b10;color:#f4f4f4;font-family:Arial,sans-serif}
header{background:#12151d;padding:22px 16px;border-bottom:2px solid #d8ad42}
h1{color:#f4c64e;font-size:25px;margin:0 0 8px}
.sub{color:#aaa;font-size:13px}
main{max-width:600px;margin:auto;padding:16px}
.card{background:#151923;border:1px solid #333845;border-radius:15px;padding:18px;margin-bottom:15px}
.label{color:#aaa;font-size:12px;text-transform:uppercase;letter-spacing:1px}
.price{font-size:29px;color:#f4c64e;font-weight:bold;margin:12px 0}
.signal{font-size:28px;font-weight:bold;color:#f4c64e;margin:12px 0}
button{background:#e9b83f;color:#151515;font-weight:bold;border:0;padding:13px;border-radius:9px;width:100%;font-size:15px}
input{width:100%;padding:12px;margin:8px 0 15px;background:#090b10;border:1px solid #444;color:white;border-radius:8px}
.row{display:flex;gap:10px}
.row>div{flex:1;background:#0c0f16;padding:12px;border-radius:9px}
.value{font-weight:bold;margin-top:8px;overflow-wrap:anywhere}
.notice{font-size:13px;line-height:1.6;color:#c7c7c7}
footer{text-align:center;color:#777;font-size:12px;padding:20px}
.green{color:#55dc91}.red{color:#ff7070}
</style>
</head>
<body>
<header>
<h1>🟡 GoodyFx AI Gold Signal</h1>
<div class="sub">XAUUSD · M30 · MT5 Trading Assistant</div>
</header>

<main>
<div class="card">
<div class="label">Gold Market</div>
<div class="price" id="price">Unavailable</div>
<div class="sub">Live market connection not configured</div>
</div>

<div class="card">
<div class="label">Current Signal</div>
<div class="signal" id="signal">WAIT</div>
<div class="notice" id="reason">Live gold prices and verified M30 candles are required before a trading signal can be calculated.</div>
<br>
<button onclick="refresh()">CHECK MARKET STATUS</button>
<div class="sub" id="updated" style="margin-top:12px">No live data received</div>
</div>

<div class="card">
<div class="label">Risk Calculator</div>
<p class="notice">Enter your account balance and the percentage you are willing to risk.</p>
<label>Account balance ($)</label>
<input id="balance" type="number" placeholder="e.g. 100" min="0">
<label>Risk (%)</label>
<input id="risk" type="number" value="1" min="0" max="100" step="0.1">
<button onclick="calculate()">CALCULATE RISK</button>
<div class="price" id="riskresult">$1.00</div>
<div class="notice">Maximum planned loss based on your inputs. This is not a lot-size recommendation.</div>
</div>

<div class="card">
<div class="label">Signal Rules</div>
<p class="notice">Timeframe: M30<br>
Market: XAUUSD<br>
Trend indicators: EMA 50 / EMA 200<br>
Momentum: RSI and MACD<br>
Risk tool: Account risk calculator</p>
</div>

<div class="card">
<div class="label">Important Notice</div>
<p class="notice">This is an early version. It does not yet receive live gold prices or calculate verified BUY/SELL signals. WAIT means no verified trading signal is available. Do not use this page alone to place trades. Gold trading involves substantial risk.</p>
</div>
</main>
<footer>GoodyFx AI Gold Signal · Built for mobile</footer>

<script>
function refresh(){
 document.getElementById('price').textContent='Unavailable';
 document.getElementById('signal').textContent='WAIT';
 document.getElementById('reason').textContent='No verified live XAUUSD feed is connected. No BUY or SELL recommendation will be invented.';
 document.getElementById('updated').textContent='Checked: '+new Date().toLocaleString();
}
function calculate(){
 const b=Number(document.getElementById('balance').value);
 const r=Number(document.getElementById('risk').value);
 const out=document.getElementById('riskresult');
 if(!Number.isFinite(b)||!Number.isFinite(r)||b<=0||r<=0||r>100){
  out.textContent='Enter valid values';return;
 }
 out.textContent='$'+(b*r/100).toFixed(2);
}
refresh();
</script>
</body>
</html>
